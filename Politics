<script>
let store={meta:{},issues:[]}, category="전체";
const $=s=>document.querySelector(s), $$=s=>[...document.querySelectorAll(s)];
const fmt=s=>s?new Intl.DateTimeFormat('ko-KR',{dateStyle:'medium',timeStyle:'short'}).format(new Date(s)):'-';
const kstDate=(d=new Date())=>new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Seoul'}).format(d);

async function loadData(){
  try{
    const r=await fetch('data.json?ts='+Date.now());
    if(!r.ok) throw new Error('data.json load failed');
    store=await r.json();
  }catch(e){
    document.querySelector('#notice').textContent='data.json을 불러오지 못했습니다. 로컬에서는 간단한 웹서버로 실행하세요.';
    return;
  }
  initCountries(); render();
}
function initCountries(){
  const countries=[...new Set(store.issues.flatMap(x=>x.countries||[]))].sort();
  $('#countryFilter').innerHTML='<option value="">전체 국가·지역</option>'+countries.map(x=>`<option>${x}</option>`).join('');
}
function filtered(){
  const mode=$('#viewMode').value, date=$('#dateFilter').value, month=$('#monthFilter').value;
  const imp=$('#importanceFilter').value, country=$('#countryFilter').value, q=$('#searchInput').value.trim().toLowerCase();
  const today=kstDate(), y=new Date(); y.setDate(y.getDate()-1); const yesterday=kstDate(y);
  return store.issues.filter(x=>{
    const d=x.occurredAt.slice(0,10);
    if(category!=='전체' && x.primaryCategory!==category && x.relatedCategory!==category) return false;
    if(mode==='today' && d!==today) return false;
    if(mode==='yesterday' && d!==yesterday) return false;
    if(mode==='daily' && date && d!==date) return false;
    if(mode==='monthly' && month && !d.startsWith(month)) return false;
    if(imp && x.importance!==imp) return false;
    if(country && !(x.countries||[]).includes(country)) return false;
    if(q && !JSON.stringify(x).toLowerCase().includes(q)) return false;
    return true;
  }).sort((a,b)=>new Date(b.updatedAt)-new Date(a.updatedAt));
}
function renderStatus(items){
  const counts={
    "전체":items.length,
    "국내 정치":items.filter(x=>x.primaryCategory==='국내 정치').length,
    "외교·대외관계":items.filter(x=>x.primaryCategory==='외교·대외관계').length,
    "확인 중":items.filter(x=>x.status==='확인 중').length
  };
  $('#statusGrid').innerHTML=Object.entries(counts).map(([k,v])=>`<div class="stat"><div class="muted">${k}</div><div class="value">${v}</div></div>`).join('');
}
function render(){
  const items=filtered();
  $('#notice').innerHTML=`<b>데이터 상태:</b> ${store.meta.notice||''}<br><span class="muted">마지막 정상 업데이트: ${fmt(store.meta.lastSuccessfulUpdate)} · 다음 예정: ${fmt(store.meta.nextScheduledUpdate)}</span>`;
  renderStatus(items); $('#resultCount').textContent=`${items.length}건`;
  const mode=$('#viewMode').value;
  $('#sectionHeading').textContent={realtime:'실시간 주요 이슈',today:'오늘의 이슈',yesterday:'어제의 확정 브리핑',daily:'일별 브리핑',monthly:'월별 아카이브'}[mode];
  $('#issueList').innerHTML=items.length?items.map(issueCard).join(''):'<div class="empty">조건에 맞는 이슈가 없습니다.</div>';
}
function issueCard(x){
  const cls=x.primaryCategory==='국내 정치'?'domestic':'foreign';
  const sources=(x.sources||[]).map(s=>`<li><a href="${s.url}" target="_blank" rel="noopener noreferrer">${s.name} — ${s.title} (${s.date})</a></li>`).join('');
  const countries=(x.countries||[]).join(', ')||'해당 없음';
  return `<article class="issue ${cls}">
    <div class="badges">
      <span class="badge">${x.primaryCategory}</span>
      <span class="badge">${x.subcategory}</span>
      <span class="badge ${x.importance==='핵심'?'core':''}">${x.importance}</span>
      <span class="badge ${x.status==='공식 발표 확인'?'verified':''}">${x.status}</span>
    </div>
    <h3>${x.title}</h3>
    <div class="muted">발생: ${fmt(x.occurredAt)} · 최종 업데이트: ${fmt(x.updatedAt)} · 관련 국가: ${countries}</div>
    <p>${x.summary}</p>
    <details><summary>세부 내용 및 출처</summary>
      ${x.background?`<p><b>배경</b><br>${x.background}</p>`:''}
      ${x.significance?`<p><b>주요 쟁점 및 의미</b><br>${x.significance}</p>`:''}
      ${x.nextSchedule?`<p><b>향후 일정</b><br>${x.nextSchedule}</p>`:''}
      <p><b>출처</b></p><ul class="source-list">${sources}</ul>
    </details>
  </article>`;
}
$$('.tab').forEach(b=>b.onclick=()=>{$$('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');category=b.dataset.cat;render()});
['viewMode','dateFilter','monthFilter','importanceFilter','countryFilter'].forEach(id=>$('#'+id).onchange=render);
$('#searchInput').oninput=render;
$('#resetBtn').onclick=()=>{category='전체';$$('.tab').forEach((x,i)=>x.classList.toggle('active',i===0));$('#viewMode').value='realtime';$('#dateFilter').value='';$('#monthFilter').value='';$('#importanceFilter').value='';$('#countryFilter').value='';$('#searchInput').value='';render()};
$('#printBtn').onclick=()=>window.print();
$('#refreshBtn').onclick=loadData;
setInterval(loadData,5*60*1000);
loadData();
</script>
